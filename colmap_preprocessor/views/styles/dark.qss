/* ── COLMAP Preprocessor — Apple Dark ──────────────────────────────── */
/*  Borderless · Pixel-aligned · Card-based sections                   */

/* ── Global ── */
QMainWindow { background-color: #1c1c1e; }
QWidget {
    color: #ffffff;
    font-size: 13px;
    font-family: "Segoe UI", "Segoe UI Variable", "Microsoft YaHei UI", "SF Pro Text", system-ui, sans-serif;
}

/* ── Left panel (form area) — explicit bg so theme switch refreshes it ── */
/* Without these rules, QScrollArea's viewport inherits QPalette.Window,
   which Qt's stylesheet engine doesn't reliably refresh on setStyleSheet(). */
QScrollArea#leftPanel,
QScrollArea#leftPanel > QWidget#qt_scrollarea_viewport {
    background-color: #1c1c1e;
    border: none;
}
QWidget#leftPanelContent {
    background-color: #1c1c1e;
}

/* ── Section Header ── */
QLabel#sectionHeader {
    font-size: 11px;
    font-weight: 600;
    color: #8e8e93;
    letter-spacing: 0.5px;
    padding-bottom: 2px;
}

/* ── Section Card (rounded container for settings) ── */
QWidget#sectionCard {
    background-color: #2c2c2e;
    border-radius: 10px;
}

/* ── Section Toggle (collapsible header button) ── */
QPushButton#sectionToggle {
    background: transparent;
    border: none;
    color: #8e8e93;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-align: left;
    padding: 2px 0;
}
QPushButton#sectionToggle:hover { color: #ffffff; }

/* ── Section Checkbox (enable/disable whole section) ── */
QCheckBox#sectionCheck {
    spacing: 6px;
    color: #8e8e93;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}
QCheckBox#sectionCheck::indicator {
    width: 16px; height: 16px;
    border: none; border-radius: 4px;
    background-color: #636366;
}
QCheckBox#sectionCheck::indicator:checked { background-color: #30d158; }
QCheckBox#sectionCheck::indicator:hover { background-color: #48484a; }
QCheckBox#sectionCheck::indicator:checked:hover { background-color: #34c759; }

/* ── Form Labels (right-aligned in grid) ── */
QLabel#formLabel {
    color: #98989d;
    font-size: 12px;
    padding-right: 4px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #3a3a3c;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 3px 10px;
    min-height: 18px;
}
QPushButton:hover { background-color: #4a4a4c; }
QPushButton:pressed { background-color: #636366; }
QPushButton:disabled { background-color: #2c2c2e; color: #48484a; }

QPushButton#btnRun {
    background-color: #30d158;
    color: #000000;
    font-weight: 600;
    font-size: 14px;
    padding: 10px 24px;
    border-radius: 10px;
}
QPushButton#btnRun:hover { background-color: #34c759; }
QPushButton#btnRun:disabled { background-color: #2c2c2e; color: #48484a; }

/* ── Secondary action (Open Output Folder) — outlined style ── */
QPushButton#btnSecondary {
    background-color: transparent;
    color: #0a84ff;
    border: 1px solid #3a3a3c;
    font-weight: 500;
    font-size: 12px;
    padding: 7px 24px;
    border-radius: 10px;
}
QPushButton#btnSecondary:hover { background-color: #1c1c1e; border-color: #48484a; }
QPushButton#btnSecondary:pressed { background-color: #2c2c2e; }
QPushButton#btnSecondary:disabled { color: #48484a; border-color: #2c2c2e; }

/* ── Checkable buttons (downscale) ── */
QPushButton[checkable="true"] {
    padding: 5px 14px;
    min-width: 40px;
    font-weight: 500;
}
QPushButton[checkable="true"]:checked {
    background-color: #0a84ff;
    color: #ffffff;
}

/* ── ComboBox ── */
QComboBox {
    background-color: #3a3a3c;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 2px 8px;
    min-height: 18px;
    min-width: 80px;
}
QComboBox:hover { background-color: #4a4a4c; }
QComboBox:focus { background-color: #4a4a4c; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    color: #ffffff;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 6px;
    outline: none;
    min-width: 180px;
}
QComboBox QAbstractItemView::item {
    padding: 5px 12px;
    border-radius: 6px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #3a3a3c;
}

/* ── SpinBox ── */
QSpinBox, QDoubleSpinBox {
    background-color: #3a3a3c;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 2px 8px;
    min-height: 18px;
    min-width: 80px;
}
QSpinBox:focus, QDoubleSpinBox:focus { background-color: #4a4a4c; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px; border: none;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px; border: none;
}

/* ── LineEdit ── */
QLineEdit {
    background-color: #3a3a3c;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}
QLineEdit:focus { background-color: #4a4a4c; }

/* ── ListWidget ── */
QListWidget {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    outline: none;
}
QListWidget::item { padding: 4px 10px; border-radius: 6px; }
QListWidget::item:selected { background-color: #0a84ff; color: #ffffff; }
QListWidget::item:hover { background-color: #3a3a3c; }
QListWidget::item:alternate { background-color: #2c2c2e; }

/* ── CheckBox ── */
QCheckBox { spacing: 5px; color: #e5e5ea; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: none; border-radius: 4px;
    background-color: #636366;
}
QCheckBox::indicator:checked { background-color: #0a84ff; }
QCheckBox::indicator:hover { background-color: #48484a; }
QCheckBox::indicator:checked:hover { background-color: #409cff; }

/* ── ProgressBar ── */
QProgressBar {
    border: none; border-radius: 6px;
    text-align: center; height: 20px;
    background-color: #3a3a3c;
    color: #98989d; font-size: 11px;
}
QProgressBar::chunk {
    background-color: #0a84ff;
    border-radius: 6px;
}

/* ── Slider ── */
QSlider::groove:horizontal {
    height: 4px; background: #48484a; border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #ffffff;
    width: 16px; height: 16px;
    margin: -6px 0; border-radius: 8px;
}
QSlider::handle:horizontal:hover { background: #e5e5ea; }
QSlider::sub-page:horizontal {
    background: #0a84ff; border-radius: 2px;
}

/* ── ScrollArea ── */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    background: transparent; width: 6px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #48484a; border-radius: 3px; min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #636366; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent; height: 6px; margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #48484a; border-radius: 3px; min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #636366; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── StatusBar ── */
QStatusBar {
    background-color: #1c1c1e;
    color: #636366;
    border-top: none;
    font-size: 11px;
    padding: 0 12px;
}

/* ── ToolTip ── */
QToolTip {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ── Toolbar ── */
QWidget#toolbar {
    background-color: #1c1c1e;
    border-bottom: none;
}
QLabel#appTitle {
    font-size: 15px; font-weight: 700;
    color: #ffffff; letter-spacing: 0.5px;
}
QLabel#statusInfo { color: #636366; font-size: 11px; }
QPushButton#themeBtn {
    border: 1px solid #3a3a3c;
    background: #2c2c2e; border-radius: 14px;
    padding: 2px;
}
QPushButton#themeBtn:hover { background-color: #3a3a3c; border-color: #48484a; }

/* ── Hint labels ── */
QLabel#hintLabel { color: #636366; font-size: 11px; }
QLabel#customClassLabel { color: #bf5af2; font-size: 11px; font-weight: 500; }
QLabel#previewInfo { color: #8e8e93; font-size: 11px; }

/* ── GPU status indicator (toolbar) ── */
QLabel#gpuStatusOk      { color: #30d158; font-size: 11px; font-weight: 600; }
QLabel#gpuStatusWarn    { color: #ff9f0a; font-size: 11px; font-weight: 600; }
QLabel#gpuStatusErr     { color: #ff453a; font-size: 11px; font-weight: 600; }
QLabel#gpuStatusUnknown { color: #8e8e93; font-size: 11px; font-weight: 600; }

/* ── Preview ── */
QLabel#previewLabel {
    background-color: #2c2c2e;
    border: none; border-radius: 12px;
    color: #48484a; font-size: 13px;
}

/* ── Splitter ── */
QSplitter::handle { background-color: #2c2c2e; width: 1px; }
QSplitter::handle:hover { background-color: #48484a; }

/* ── Result ── */
QLabel#resultLabel {
    background-color: #1b3a1b;
    color: #30d158;
    padding: 10px 14px; border-radius: 10px;
    font-size: 12px; font-weight: 500;
}
